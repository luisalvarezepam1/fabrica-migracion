# Copia este archivo a .env (está en .gitignore) y completa tus datos.
# Sin .env, la fábrica trabaja con un tablero local en lugar de Jira.
# Espacio de la demo: https://thelg.atlassian.net/jira/software/c/projects/MIG/boards/35
JIRA_URL=https://tu-sitio.atlassian.net
JIRA_EMAIL=tu-correo@empresa.com
# Token de API: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=
JIRA_PROYECTO=MIG
# Si tu Jira está en español, los tipos pueden llamarse distinto:
# JIRA_TIPO_EPICA=Épica
# JIRA_TIPO_TAREA=Tarea
# JIRA_MODO=local
