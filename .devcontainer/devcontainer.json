{
  // Ambiente listo para correr la fábrica en GitHub Codespaces (o en Dev Containers con Docker):
  // Python 3.12, .NET 8 y Terraform, sin instalar nada en tu laptop.
  "name": "Fábrica de migración",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-8.0-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/terraform:1": {}
  },
  "postCreateCommand": "dotnet restore plataforma/plantillas/dotnet-api/Plantilla.sln && python3 herramientas/fabrica.py verificar",
  "forwardPorts": [5050, 5080],
  "portsAttributes": {
    "5050": { "label": "Origen (Python)" },
    "5080": { "label": "Destino (.NET)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["GitHub.copilot", "GitHub.copilot-chat", "ms-dotnettools.csharp", "ms-python.python"]
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
